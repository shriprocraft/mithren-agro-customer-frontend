# Copy to .env.local and fill in what you have. Every value is public (NEXT_PUBLIC_*), so never put a
# secret, key or password here. Leave a value empty and the site shows a safe "coming soon" or
# "unavailable" state instead of a link. Values are read at build time: rebuild after changing them.
# See docs/CONFIGURATION.md.

# The separate Investor Portal application (https only; http is accepted for localhost).
NEXT_PUBLIC_INVESTOR_PORTAL_URL=

# Agent application forms, once registration opens.
NEXT_PUBLIC_SELLER_AGENT_APPLY_URL=
NEXT_PUBLIC_DELIVERY_AGENT_APPLY_URL=

# Homepage video cards: an https URL or a path to a file under public/ (for example /videos/farm-to-home.mp4).
NEXT_PUBLIC_VIDEO_FARM_TO_HOME_URL=
NEXT_PUBLIC_VIDEO_GROW_WITH_US_URL=

# Development-only order tracking controls in a production build (see docs/ARCHITECTURE.md).
NEXT_PUBLIC_DEMO_TOOLS=
